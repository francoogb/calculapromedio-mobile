{
  "expo": {
    "name": "CalculaPromedio",
    "slug": "calculapromedio-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calculapromedio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cl.calculapromedio.app"
    },
    "android": {
      "package": "cl.calculapromedio.app",
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tus fotos para poder resolver ejercicios.",
          "cameraPermission": "Necesitamos acceso a la cámara para fotografiar ejercicios."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Necesitamos acceso a la cámara para fotografiar ejercicios."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070B1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00b88b81-e677-4fca-b20a-1ffd67473135"
      }
    }
  }
}
